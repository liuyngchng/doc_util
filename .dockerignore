# Docker 构建上下文配置
#
# 两种构建场景共用此文件：
#   1. build_cli.sh —— 用 Dockerfile 构建 GUI，只需要 build/deps 下的 Go 工具链 tarball
#   2. build_server.sh --docker —— 用 Dockerfile.server 构建 server，需要源码 + models + onnxruntime
#
# 下面只排除真正不该进上下文的东西。

# VCS
.git
.gitignore

# IDE / project config
.claude
.idea
.vscode
*.swp
*.swo
*~
.DS_Store

# 编译缓存（体积大，运行期通过 -v 挂载或镜像内重建）
build/gocache
build/gocache_dev
build/gomodcache

# 自签名证书源（构建脚本会先复制到 dist/ 再进镜像）
certs

# 构建产物（server/MCP 镜像只需要 dist/ 下的 server 二进制、onnxruntime、models）
vendor
dist/*.tar
dist/pdf2docx
dist/pdf2docx.exe
dist/pdf2docx-linux-amd64/
dist/pdf2docx-windows-amd64/
dist/libopencv_*.so.*
dist/libtbb.so*

# 文档（Docker 镜像用不到）
README.md
API.md
CLAUDE.md

# 旧的 GUI 构建脚本（server 用不到）
build.sh
scripts/build.bat
