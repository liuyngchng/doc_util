# ================================================================
# Production Docker image for the pdf2docx MCP server.
#
# This image only packages a PRE-BUILT binary from dist/ — it does NOT
# compile. Build the binary first (inside Docker) then build the image:
#
#   ./scripts/build_mcp.sh                  # builds binary + image in one go
#
# Run (note: stdin must be attached, and stdout is the JSON-RPC transport):
#   docker run -i --rm pdf2docx-mcp:latest
#
# Register in Claude Desktop's claude_desktop_config.json:
#   {
#     "mcpServers": {
#       "pdf2docx": {
#         "command": "docker",
#         "args": ["run", "-i", "--rm", "pdf2docx-mcp:latest"]
#       }
#     }
#   }
# ================================================================

FROM ubuntu:24.04

ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG NO_PROXY=""
ENV HTTP_PROXY="$HTTP_PROXY" HTTPS_PROXY="$HTTPS_PROXY" NO_PROXY="$NO_PROXY" \
    http_proxy="$HTTP_PROXY" https_proxy="$HTTPS_PROXY" no_proxy="$NO_PROXY"

RUN if [ -n "$HTTP_PROXY" ]; then \
        echo "Acquire::http::Proxy \"$HTTP_PROXY\";" > /etc/apt/apt.conf.d/01proxy; \
    fi; \
    if [ -n "$HTTPS_PROXY" ]; then \
        echo "Acquire::https::Proxy \"$HTTPS_PROXY\";" >> /etc/apt/apt.conf.d/01proxy; \
    fi

# Runtime deps: OpenCV libs for OCR.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopencv-core406t64 \
    libopencv-imgproc406t64 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Pre-built binary + ONNX Runtime shared lib + OCR models.
COPY dist/pdf2docx-mcp /app/pdf2docx-mcp
COPY dist/libonnxruntime.so* /app/
COPY dist/models /app/models

ENV LOG_LEVEL=info

ENTRYPOINT ["/app/pdf2docx-mcp"]