# ================================================================
# Production Docker image for the doc_util HTTP server.
#
# This image only packages a PRE-BUILT binary from dist/ — it does NOT
# compile. Build the binary first (inside Docker) then build the image:
#
#   ./build/build_server.sh --docker     # builds binary + image in one go
#
#   # or step by step:
#   ./build/build_server.sh              # 1) build binary → dist/
#   docker build -t doc_util:$(cat VERSION) -f build/Dockerfile.server .
#   #                                 2) package dist/ into image
#
# Run:
#   docker run -d --rm --name doc_util -p 8443:8080 \
#     -v $(pwd)/logs:/app/logs \
#     doc_util:$(cat VERSION)
#   docker logs -f doc_util
#   curl -k https://localhost:8443/health
#   # logs are also on the host at ./logs/server.log
# ================================================================

FROM ubuntu:24.04

ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG NO_PROXY=""

# ARG values are only available during build-time RUN commands;
# they are NOT persisted into the final image (no ENV for proxy).

RUN if [ -n "$HTTP_PROXY" ]; then \
        echo "Acquire::http::Proxy \"$HTTP_PROXY\";" > /etc/apt/apt.conf.d/01proxy; \
    fi; \
    if [ -n "$HTTPS_PROXY" ]; then \
        echo "Acquire::https::Proxy \"$HTTPS_PROXY\";" >> /etc/apt/apt.conf.d/01proxy; \
    fi

# Runtime deps: OpenCV libs for OCR + LibreOffice headless for legacy .doc support.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopencv-core406t64 \
    libopencv-imgproc406t64 \
    libreoffice-writer-nogui \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/apt/apt.conf.d/01proxy

WORKDIR /app

# Pre-built binary + ONNX Runtime shared lib + OCR models.
COPY dist/doc_util /app/doc_util
COPY dist/libonnxruntime.so* /app/
COPY dist/models /app/models

# Self-signed TLS certificate (generated by build/gen_cert.sh).
# Set these env vars to enable HTTPS — the server falls back to HTTP
# when the files are missing or the vars are unset.
COPY dist/cert.pem dist/key.pem /app/
ENV TLS_CERT_FILE=/app/cert.pem
ENV TLS_KEY_FILE=/app/key.pem

ENV PORT=8080
ENV LOG_DIR=/app/logs

# Volume mount point for persistent logs (map with -v on the host).
VOLUME ["/app/logs"]

EXPOSE 8080

ENTRYPOINT ["/app/doc_util"]